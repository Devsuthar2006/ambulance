# ==============================================================================
# RESQAI — Environment Configuration Template
# Copy this file to .env and configure as needed. DO NOT commit .env with secrets.
# ==============================================================================

# Simulation & Dispatch Parameters
SEED=20260911
COVERAGE_PENALTY=20.0
SCARCITY_PENALTY=15.0
DEFAULT_POLICY=coverage

# Server Configuration
API_HOST=0.0.0.0
PORT=8000

# ==============================================================================
# AI Emergency Triage Configuration
# ==============================================================================
# Options:
#   "groq"   - Groq Ultra-Fast LPU Inference (Sub-200ms) [RECOMMENDED]
#   "gemini" - Google Gemini (gemini-1.5-flash / gemini-2.5-flash)
#   "openai" - OpenAI GPT-4o-mini
#   "mock"   - Offline deterministic triage (No API key needed)
TRIAGE_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# (Optional Alternative LLMs)
# GEMINI_API_KEY=your_google_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Telephony & Voice Intake Configuration
# ==============================================================================
# Options:
#   "demo"    - Synthetic emergency radio call triggers (0 API keys needed)
#   "browser" - Real-time browser microphone via Web Speech API (0 API keys needed)
#   "phone"   - Real telephone calls via Twilio or Telnyx webhook
VOICE_PROVIDER=demo

# Twilio Telephony Webhook (Optional for real phone numbers)
# Free trial signup at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PHONE_NUMBER=+1-800-555-RESQ
